{
  "name": "jharlab",
  "version": "1.2.1",
  "description": "JharLab Laboratory Information System",
  "author": "Md Musharraf",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/schema-sql.js && node scripts/build.js",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.2.2",
    "dotenv": "^17.4.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "next": "14.2.35",
    "pdf-lib": "^1.17.1",
    "postcss": "^8",
    "prisma": "5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^7.2.0",
    "zod": "^3.22.4"
  },
  "build": {
    "appId": "com.offlinelab.lis",
    "productName": "JharLab",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/logo.png",
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/*.js",
      "lib/*.json",
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "client/**/*",
          "schema.sql"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  }
}
