generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model LabSettings {
  id               Int       @id @default(autoincrement())
  labName          String
  logo             Bytes?    // stored as base64 blob
  address          String
  mobile           String
  email            String?
  website          String?
  gstNumber        String?
  registrationNo   String?
  reportFooter     String?
  doctorName       String?
  doctorQualification String?
  doctorRegNo      String?
  pathologyDoctorName String?
  pathologyDoctorQualification String?
  pathologyDoctorRegNo String?
  technicianName   String?
  technicianQualification String?
  technicianRegNo  String?
  signature        Bytes?
  technicianSignature Bytes?
  pathologyDoctorSignature Bytes?
  stamp            Bytes?
  printHeader      String?   // tagline under the lab name on reports
  logoCaption      String?   // short line printed under the logo on reports
  nablNumber       String?
  // How reports print (applied at print time, also to old reports)
  printShowLogo    Boolean   @default(true)
  printShowQR      Boolean   @default(true)
  printSignatures  Boolean   @default(true)
  letterhead       Boolean   @default(false) // pre-printed paper: leave header/footer space blank
  letterheadTopMm  Int       @default(40)
  letterheadBottomMm Int     @default(20)
  printColor       String    @default("#0e7490") // report accent colour
  printFontSize    Int       @default(10)        // result table text size, pt
  // Who signs (frozen into each report when it is approved)
  coSigning        Boolean   @default(false)
  licenseKey       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String    // bcrypt hashed
  recoveryHash String?   // owner only: bcrypt hash of the one-time recovery code
  role         String    @default("RECEPTIONIST") // Role enum
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  avatar       Bytes?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  activityLogs ActivityLog[]
  patients     Patient[]
}

model Patient {
  id               String    @id  // e.g., LAB-2024-00001
  name             String
  age              Int
  ageUnit          String    @default("YEARS") // AgeUnit enum
  gender           String    // Gender enum
  mobile           String
  email            String?
  address          String?
  bloodGroup       String?
  emergencyContact String?
  referredDoctor   String?
  referredDoctorId Int?
  doctor           Doctor?   @relation(fields: [referredDoctorId], references: [id])
  isEmergency      Boolean   @default(false)
  createdBy        Int
  user             User      @relation(fields: [createdBy], references: [id])
  registeredAt     DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  orders           TestOrder[]
  bills            Bill[]

  @@index([name])
  @@index([mobile])
  @@index([registeredAt])
}

model TestCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  tests       Test[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Test {
  id               Int           @id @default(autoincrement())
  code             String        @unique  // e.g., CBC001
  name             String
  shortName        String?
  categoryId       Int
  category         TestCategory  @relation(fields: [categoryId], references: [id])
  price            Float
  duration         Int           // TAT in hours
  sampleType       String        // Blood, Urine, Stool, etc.
  container        String?       // EDTA, Plain, etc.
  volume           String?       // 3ml, 5ml
  instructions     String?       // Patient preparation
  methodology      String?
  isActive         Boolean       @default(true)
  isPanel          Boolean       @default(false)  // true = group test
  panelTests       String?       // JSON array of IDs of sub-tests if panel (SQLite doesn't support Int[])
  parameters       TestParameter[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  orderItems       TestOrderItem[]
}

model TestParameter {
  id              Int       @id @default(autoincrement())
  testId          Int
  test            Test      @relation(fields: [testId], references: [id])
  name            String
  shortName       String?
  unit            String?
  sortOrder       Int       @default(0)
  type            String    @default("NUMERIC") // ParameterType enum
  options         String?   // JSON array for dropdown type
  formula         String?   // for calculated fields
  isHeader        Boolean   @default(false)  // section header row
  refRanges       ReferenceRange[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([testId])
}

model ReferenceRange {
  id             Int      @id @default(autoincrement())
  parameterId    Int
  parameter      TestParameter @relation(fields: [parameterId], references: [id])
  gender         String?  // Gender enum, null = both
  ageMin         Int?     // in days for precise matching
  ageMax         Int?
  normalMin      Float?
  normalMax      Float?
  criticalMin    Float?
  criticalMax    Float?
  textNormal     String?  // for text-type parameters
  unit           String?
  interpretation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([parameterId])
}

model TestOrder {
  id             Int           @id @default(autoincrement())
  orderNo        String        @unique  // LAB-ORD-20240101-0001
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  billId         Int?
  bill           Bill?         @relation(fields: [billId], references: [id])
  collectedAt    DateTime?
  expectedAt     DateTime?
  deliveredAt    DateTime?
  priority       String        @default("ROUTINE") // Priority enum
  status         String        @default("PENDING") // OrderStatus enum
  barcodeData    String?       // encoded barcode string
  qrData         String?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          TestOrderItem[]
  report         Report?

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model TestOrderItem {
  id                 Int         @id @default(autoincrement())
  orderId            Int
  order              TestOrder   @relation(fields: [orderId], references: [id])
  testId             Int
  test               Test        @relation(fields: [testId], references: [id])
  selectedParameters String?     // Comma-separated list of parameter IDs of selected parameters
  price              Float?      // charged when ordered; later test price changes do not touch it
  results            TestResult[]
  status             String      @default("PENDING") // ItemStatus enum
  enteredBy          Int?
  verifiedBy         Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([orderId])
}

model TestResult {
  id              Int            @id @default(autoincrement())
  orderItemId     Int
  orderItem       TestOrderItem  @relation(fields: [orderItemId], references: [id])
  parameterId     Int
  numericValue    Float?
  textValue       String?
  status          String         // ResultStatus enum
  flag            String?        // ↑ ↓ !! or null
  isCritical      Boolean        @default(false)
  isAbnormal      Boolean        @default(false)
  note            String?
  enteredAt       DateTime       @default(now())
  enteredBy       Int

  @@index([orderItemId])
  @@index([parameterId])
  @@index([enteredBy, enteredAt])
}

model Bill {
  id              Int         @id @default(autoincrement())
  billNo          String      @unique
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id])
  subtotal        Float
  discountType    String       @default("FLAT") // DiscountType enum
  discountValue   Float       @default(0)
  discountAmount  Float       @default(0)
  gstPercent      Float       @default(0)
  gstAmount       Float       @default(0)
  totalAmount     Float
  paidAmount      Float       @default(0)
  dueAmount       Float       @default(0)
  paymentMethod   String       @default("CASH") // PaymentMethod enum
  paymentStatus   String       @default("UNPAID") // PaymentStatus enum
  referralCommission Float?
  notes           String?
  lab             String?     // lab name/address/phone/GSTIN when the bill was made (JSON), so reprints keep them
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orders          TestOrder[]
  payments        Payment[]

  @@index([patientId])
  @@index([createdAt])
}

model Payment {
  id        Int      @id @default(autoincrement())
  billId    Int
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Float
  method    String   // PaymentMethod enum
  reference String?
  paidAt    DateTime @default(now())
  receivedBy Int

  @@index([billId])
  @@index([receivedBy, paidAt])
}

model Report {
  id          Int       @id @default(autoincrement())
  orderId     Int       @unique
  order       TestOrder @relation(fields: [orderId], references: [id])
  pdfData     Bytes?    // unused (older versions)
  // Everything the report prints, frozen at approval (JSON, images as ReportAsset hashes), so later
  // changes to the logo, address, signatures, tests, ranges or patient details never rewrite it.
  snapshot    String?
  version     Int       @default(0) // times approved; above 1 = amended
  printCount  Int       @default(0)
  approvedBy  Int?
  approvedAt  DateTime?
  deliveredAt DateTime?
  deliveryMethod String? // DeliveryMethod enum
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Logo and signature images printed on approved reports, stored once per distinct image.
model ReportAsset {
  hash      String   @id // sha256 of data
  data      Bytes
  createdAt DateTime @default(now())
}

model Doctor {
  id           Int      @id @default(autoincrement())
  name         String
  qualification String?
  hospital     String?
  mobile       String?
  email        String?
  commission   Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patients     Patient[]
}

model Staff {
  id           Int      @id @default(autoincrement())
  name         String
  role         String   // Role enum
  mobile       String?
  salary       Float?
  joinedAt     DateTime?
  isActive     Boolean  @default(true)
  userId       Int?     @unique // login account (User.id), if this person can sign in
  shift        String?  // MORNING | EVENING | NIGHT | FULL_DAY | CUSTOM
  shiftStart   String?  // "08:00"
  shiftEnd     String?  // "14:00"; may be earlier than start for night shifts
  attendance   Attendance[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Attendance {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id])
  date      DateTime
  status    String   // AttendanceStatus enum
  inTime    String?
  outTime   String?
  note      String?

  @@index([staffId, date])
}

model InventoryItem {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  unit          String
  currentStock  Float
  minStock      Float
  maxStock      Float?
  expiryDate    DateTime?
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  supplierName  String?  // free-text supplier shown on the stock register
  batchNumber   String?
  purchasePrice Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  InventoryTransaction[]
}

model Supplier {
  id       Int      @id @default(autoincrement())
  name     String
  mobile   String?
  email    String?
  address  String?
  items    InventoryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      String   // TxType enum
  quantity  Float
  note      String?
  createdAt DateTime @default(now())
  createdBy Int
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  module    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model BackupLog {
  id         Int      @id @default(autoincrement())
  filename   String
  sizeBytes  Int
  type       String   // BackupType enum
  status     String
  createdAt  DateTime @default(now())
  createdBy  Int
}

model QcResult {
  id            Int      @id @default(autoincrement())
  testName      String
  parameterName String
  batchNumber   String
  level         String
  expectedValue Float
  measuredValue Float
  deviation     Float
  cv            Float
  status        String   // PASS, WARNING, FAIL
  date          DateTime @default(now())
}


// Atomic document numbers (patient IDs, order and bill numbers): "order:20261006" -> last issued sequence.
model Counter {
  key   String @id
  value Int
}

// Day-to-day lab spending (salaries, reagents, rent, ...) for the monthly profit / loss.
model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  category    String   // SALARY | REAGENT | RENT | MAINTENANCE | UTILITY | EQUIPMENT | MISC
  description String
  amount      Float
  paidTo      String?
  method      String   @default("CASH")
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Sample collection at the patient's home.
model HomeCollection {
  id           Int      @id @default(autoincrement())
  patientName  String
  phone        String?
  address      String
  tests        String?
  scheduledAt  DateTime
  status       String   @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | COLLECTED | DELIVERED_TO_LAB | CANCELLED
  assignedTo   Int?     // User.id of the phlebotomist / technician
  assignedName String?
  notes        String?
  createdBy    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

// Partner labs that run tests this lab does not, and the tests sent to them.
model OutsourceLab {
  id        Int              @id @default(autoincrement())
  name      String
  mobile    String?
  email     String?
  address   String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tests     OutsourcedTest[]
}

model OutsourcedTest {
  id               Int          @id @default(autoincrement())
  labId            Int
  lab              OutsourceLab @relation(fields: [labId], references: [id])
  patientName      String
  orderNo          String?
  testName         String
  cost             Float        @default(0)
  sentAt           DateTime     @default(now())
  status           String       @default("PENDING") // PENDING | COMPLETED | CANCELLED
  resultReceivedAt DateTime?
  notes            String?
  createdBy        Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([labId])
  @@index([sentAt])
}

// Companies / hospitals billed on credit with an agreed discount.
model Corporate {
  id         Int      @id @default(autoincrement())
  name       String
  contact    String?
  mobile     String?
  email      String?
  creditDays Int      @default(0)
  discount   Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
